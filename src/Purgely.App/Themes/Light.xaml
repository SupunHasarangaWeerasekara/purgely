<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Every key here must also exist in Dark.xaml. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F6F6FA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E4EC" />
    <SolidColorBrush x:Key="TextBrush" Color="#1C1B29" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B6A7C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6D28D9" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B21B6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EDE9FE" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F4F2FD" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#B3F6F6FA" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9C8D6" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A3A2B6" />
</ResourceDictionary>
