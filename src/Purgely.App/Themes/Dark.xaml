<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Every key here must also exist in Light.xaml. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#14131C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1D2A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2F2E40" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECEBF5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9D9CB2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C4B5FD" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2F2950" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#262537" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#B314131C" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#45445C" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5E5D78" />
</ResourceDictionary>
